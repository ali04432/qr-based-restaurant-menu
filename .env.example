# ============================================================
# QR Based Restaurant Menu — Environment Variables
# Copy this file to apps/api/.env and fill in real values.
# NEVER commit the actual .env file.
# ============================================================

# ============================================================
# DATABASE
# ============================================================
# PostgreSQL connection string"
DATABASE_URL="postgresql://neondb_owner:REPLACE_WITH_DB_PASSWORD@your-neon-host-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ============================================================
# AUTHENTICATION
# ============================================================
# Strong random secret for signing JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET"

# JWT token expiration (e.g. 7d, 24h, 30m)
JWT_EXPIRES_IN="7d"

# ============================================================
# APPLICATION
# ============================================================
# Node environment: development | production | test
NODE_ENV="development"

# Port the API server listens on
PORT=4000

# Public URL of the frontend application (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public HTTPS tunnel URL used for phone AR QR code generation (e.g. Cloudflare Tunnel or ngrok).
# When set, the desktop QR code encodes this URL so phone scanning works directly over the internet.
NEXT_PUBLIC_TUNNEL_URL=""

# Base URL of the API (used by the frontend to make requests, server-side only)
API_BASE_URL="http://localhost:4000"

# Internal URL used by Next.js server-side rewrites (/api and /models proxies)
API_INTERNAL_URL="http://localhost:4000"

# ============================================================
# FRONTEND API URL (used in browser bundle — must be NEXT_PUBLIC_)
# ============================================================
# Single source of truth for the API base URL visible to the browser.
# For local dev: set to the Next.js origin so the /api rewrite in
# next.config.js proxies requests to the Express server transparently.
# For phone AR testing via Cloudflare Tunnel or ngrok:
#   set to your tunnel URL, e.g. https://abc123.trycloudflare.com
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Kept for backward compatibility (some services fall back to this)
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# ============================================================
# CORS & TUNNELS
# ============================================================
# Comma-separated list of extra origins to allow in CORS.
# Useful for staging servers or persistent ngrok domains.
# Tunnel wildcard (*.trycloudflare.com, *.ngrok-free.app) is always allowed.
# Example: CORS_EXTRA_ORIGINS="https://staging.yourdomain.com,https://abc.ngrok-free.app"
CORS_EXTRA_ORIGINS=""

# ============================================================
# 3D MODEL UPLOAD
# ============================================================
# Base URL used to build public model URLs returned by POST /api/admin/ar/upload.
# Leave empty to return relative URLs (e.g. /models/filename.glb).
# In production: set to your CDN or static file server URL.
# Example: MODELS_BASE_URL="https://cdn.yourrestaurant.com"
MODELS_BASE_URL=""

# ============================================================
# AI PROVIDER (placeholder — not implemented in Phase 1)
# ============================================================
# AI provider to use: gemini | openai | anthropic
AI_PROVIDER="gemini"

# Google Gemini API key
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"

# ============================================================
# SOCKET.IO
# ============================================================
# Allowed CORS origins for Socket.io (comma-separated)
SOCKET_CORS_ORIGINS="http://localhost:3000"

# ============================================================
# BCRYPT
# ============================================================
# Number of bcrypt salt rounds (10-12 is a safe default)
BCRYPT_SALT_ROUNDS=12

