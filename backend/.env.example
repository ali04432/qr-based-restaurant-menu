PORT=5000
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
JWT_SECRET="your-jwt-secret-key"

# Frontend URL used for QR code generation (no trailing slash)
# For LAN testing: use your computer's LAN IP, e.g. http://192.168.1.100:3000
# For production: use the deployed HTTPS frontend URL
FRONTEND_URL="http://localhost:3000"

# Google Gemini AI — get your free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
