{
  "name": "@qr-menu/api",
  "version": "1.0.0",
  "private": true,
  "description": "Express.js REST API and Socket.io server for QR Restaurant Menu",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child -r tsconfig-paths/register src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "seed:ar": "ts-node --transpile-only -r tsconfig-paths/register scripts/seed-ar-asset.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@qr-menu/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "socket.io": "^4.7.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^3.15.0",
    "typescript": "^5.3.3"
  }
}
